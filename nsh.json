{
  "name": "nshde",
  "id": "com.example.nshde",
  "version": "0.1.0",
  "build": 1,
  "appearance": "dark",
  "theme": "theme/theme.json",
  "capabilities": {
    "network": {
      "hosts": ["127.0.0.1", "localhost", "127.0.0.1:43123", "localhost:43123", "*"]
    },
    "host": ["nshde.*"],
    "webview": {
      "hosts": ["127.0.0.1", "localhost", "127.0.0.1:43123", "localhost:43123", "*"]
    },
    "clipboard": true
  },
  "web": {
    "host": "./host.js",
    "connect": ["127.0.0.1:43123", "localhost:43123", "*"]
  }
}
